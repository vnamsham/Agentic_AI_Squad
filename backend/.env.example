# Agent AI Squad - Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3030

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# GitHub (for code reading, branch creation, pull requests)
GITHUB_TOKEN=ghp_your_token_here

# Jira (for reading stories and requirements)
JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your.email@company.com
JIRA_TOKEN=your_jira_api_token_here

# Confluence (for reading documentation and requirements)
CONFLUENCE_URL=https://yourcompany.atlassian.net/wiki
CONFLUENCE_EMAIL=your.email@company.com
CONFLUENCE_TOKEN=your_confluence_api_token_here
